{
  "name": "@anish-paleja/nginx-defender",
  "version": "2.0.0",
  "description": "Web Application Firewall and threat detection for Node.js applications",
  "main": "index.js",
  "scripts": {
    "test": "jest --passWithNoTests",
    "build": "echo 'No build step needed - using JavaScript directly'",
    "prepublishOnly": "npm test --if-present",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org"
  },
  "keywords": [
    "waf", 
    "security", 
    "firewall", 
    "threat-detection", 
    "nginx", 
    "protection",
    "middleware"
  ],
  "author": "nginx-defender team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "child_process": "^1.0.2"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anipaleja/nginx-defender.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "passWithNoTests": true,
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!node_modules/**"
    ]
  }
}
